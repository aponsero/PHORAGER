// Main Phorager Pipeline Configuration
// Includes all component configurations

manifest {
    name = 'phorager'
    version = '0.5.0-beta'
    nextflowVersion = '>=24.04.0'
}

// Base pipeline configuration
includeConfig 'configs/base.config'

// Tool-specific configurations
includeConfig 'configs/conda_tools.config'
includeConfig 'configs/profiles.config'
includeConfig 'configs/tool_parameters.config'

// Bind every root a Nextflow-staged input symlink can resolve into, since
// singularity.autoMounts/runOptions don't apply to manual `singularity exec`
// calls in process scripts.
def _phorager_binds = []
_phorager_binds << params.outdir
_phorager_binds << params.database_location
if (params.genome) {
    def g = new File(params.genome as String).canonicalFile
    _phorager_binds << (g.isDirectory() ? g.path : g.parent)
}
if (params.prophage) {
    def p = new File(params.prophage as String).canonicalFile
    _phorager_binds << (p.isDirectory() ? p.path : p.parent)
}
if (params.extra_bind_paths) {
    _phorager_binds.addAll(params.extra_bind_paths.toString().tokenize(','))
}
def _phorager_bind_str = _phorager_binds.findAll { it }.unique().join(',')

env {
    APPTAINER_BIND   = _phorager_bind_str
    SINGULARITY_BIND = _phorager_bind_str
}

executor {
    exitReadTimeout = '15 min'
    pollInterval = '30 sec'
    queueStatInterval = '3 min'
}

singularity.runOptions = '--cleanenv --no-home'

