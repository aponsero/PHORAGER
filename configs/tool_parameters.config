// Tool-Specific Parameters Configuration
// Container paths and verification settings for each tool

params {
    // Container specifications (for manual singularity execution)
    container_specs = [
        drep: [
            image: 'quay.io-biocontainers-drep-3.5.0--pyhdfd78af_0.img',
            docker_url: 'docker://quay.io/biocontainers/drep:3.5.0--pyhdfd78af_0',
            verification_cmd: 'dRep',
            version_pattern: 'dRep v3.5.0'
        ],
        checkm2: [
            image: 'quay.io-biocontainers-checkm2-1.0.1--pyh7cba7a3_0.img',
            docker_url: 'docker://quay.io/biocontainers/checkm2:1.0.1--pyh7cba7a3_0',
            verification_cmd: 'checkm2 -h',
            version_pattern: 'CheckM2 v1.0.1'
        ],
        genomad: [
            image: 'quay.io-biocontainers-genomad-1.8.1--pyhdfd78af_0.img',
            docker_url: 'docker://quay.io/biocontainers/genomad:1.8.1--pyhdfd78af_0',
            verification_cmd: 'genomad --version',
            version_pattern: '1.8.1'
        ],
        vibrant: [
            image: 'quay.io-biocontainers-vibrant-1.2.1--hdfd78af_4.img',
            docker_url: 'docker://quay.io/biocontainers/vibrant:1.2.1--hdfd78af_4',
            verification_cmd: 'VIBRANT_run.py --help',
            version_pattern: 'VIBRANT'
        ],
        checkv: [
            image: 'phorager-checkv-bundle-1.0.sif',
            docker_url: 'docker://ghcr.io/aponsero/phorager-checkv-bundle:1.0',
            verification_cmd: 'checkv --help',
            version_pattern: '1.0.3'
        ],
        pharokka: [
            image: 'quay.io-biocontainers-pharokka-1.9.1--pyhdfd78af_0.img',
            docker_url: 'docker://quay.io/biocontainers/pharokka:1.9.1--pyhdfd78af_0',
            verification_cmd: 'pharokka.py --version',
            version_pattern: '1.9.1'
        ],
        phold: [
            image: 'quay.io-biocontainers-phold-0.2.0--pyhdfd78af_0.img',
            docker_url: 'docker://quay.io/biocontainers/phold:0.2.0--pyhdfd78af_0',
            verification_cmd: 'phold --version',
            version_pattern: '0.2.0'
        ],
        parsing_env: [
            image: 'phorager-parsing-env-1.0.sif',
            docker_url: 'docker://ghcr.io/aponsero/phorager-parsing-env:1.0',
            verification_cmd: 'python -c "import pandas; import Bio; print(f\\"pandas {pandas.__version__}, biopython {Bio.__version__}\\")"',
            version_pattern: 'pandas 2.2.3'
        ]
    ]

    // Add database specifications
    database_specs = [
        checkm2: [
            directory: 'CheckM2_database',
            download_command: 'checkm2 database --download --path', // Not used - direct download instead
            key_file: 'uniref100.KO.1.dmnd',
            expected_size_gb: '2.9',
            description: 'CheckM2 reference database',
            download_url: 'https://zenodo.org/records/14897628/files/checkm2_database.tar.gz?download=1'
        ],
        genomad: [
            directory: 'genomad_database',
            download_command: 'genomad download-database --destination', // Not used - direct download instead
            key_file: 'genomad_db',
            version: '1.7', // must match compatible geNomad tool 1.8.1; do not bump without also updating the tool
            expected_size_gb: '1.4', // measured: extracted genomad_db/ directory (tarball itself is ~0.79 GiB)
            description: 'GenoMAD reference database',
            // Zenodo record ID is independent of the version string above and does not update automatically
            // with it - a version bump requires manually updating both this URL and the `version` key.
            // install_genomad_database.nf verifies the installed database's version.txt against `version`
            // and fails loudly if they ever drift apart.
            download_url: 'https://zenodo.org/records/10594875/files/genomad_db_v1.7.tar.gz?download=1'
        ],
        vibrant: [
            directory: 'vibrant_database',
            download_command: 'VIBRANT_setup.py', // Not used - runs rewritten setup script
            key_file: 'VOGDB94_phage.HMM',
            expected_size_gb: '11.0',
            description: 'VIBRANT HMM databases (Pfam, KEGG, VOG)'
        ],
        checkv: [
            directory: 'checkv_database',
            download_command: 'checkv download-db', // Not used - direct download instead
            key_file: 'genome_db/checkv_reps.dmnd',
            expected_size_gb: '6.4',
            description: 'CheckV reference database v1.5',
            download_url: 'https://portal.nersc.gov/CheckV/checkv-db-v1.5.tar.gz'
        ],
        pharokka: [
            directory: 'pharokka_database',
            download_command: 'install_databases.py -o', // Not used - direct download instead  
            key_file: 'phrog_annot_v4.tsv',
            expected_size_gb: '0.7',
            description: 'Pharokka annotation database v1.8.0',
            download_url: 'https://zenodo.org/records/17110353/files/pharokka_v1.8.0_databases.tar.gz'
        ],
        phold: [
            directory: 'phold_database',
            download_command: 'phold install -d',
            key_file: 'all_phold_structures_clustered_searchDB',
            expected_size_gb: '15.0',
            description: 'Phold protein function prediction database'
        ]
    ]
}